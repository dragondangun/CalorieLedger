<UserControl
    x:Class="CalorieLedger.Views.Activities.ActivityPresetEditorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CalorieLedger.ViewModels.Activities"
    x:DataType="vm:ActivityPresetEditorViewModel">

    <StackPanel Spacing="10">
        <TextBlock
            Text="{Binding Title}"
            FontSize="18"
            FontWeight="SemiBold" />

        <TextBlock Text="Название" />
        <TextBox Text="{Binding Name, Mode=TwoWay}" />

        <TextBlock Text="MET" />
        <NumericUpDown
            Value="{Binding MetValue, Mode=TwoWay}"
            Minimum="1"
            Increment="0.1" />

        <ItemsControl
            IsVisible="{Binding HasValidationErrors}"
            ItemsSource="{Binding ValidationMessages}" />

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button
                Content="Сохранить"
                Command="{Binding SaveCommand}" />

            <Button
                Content="Отмена"
                Command="{Binding CancelCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
