<UserControl
    x:Class="CalorieLedger.Views.Activities.RecurringPlannedActivityOccurrenceItemView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CalorieLedger.ViewModels.Activities"
    x:DataType="vm:RecurringPlannedActivityOccurrenceItemViewModel">

    <Border
        Padding="10"
        Margin="0,0,0,8"
        BorderThickness="1"
        CornerRadius="8">

        <StackPanel Spacing="5">
            <TextBlock
                Text="{Binding Name}"
                FontWeight="SemiBold" />

            <TextBlock
                Text="{Binding DetailsSummary}"
                Opacity="0.75" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    Content="Выполнить"
                    Command="{Binding CompleteCommand}" />

                <Button
                    Content="Изменить расписание"
                    Command="{Binding EditScheduleCommand}" />

                <Button
                    Content="Пропустить"
                    Command="{Binding SkipCommand}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
