<UserControl
    x:Class="CalorieLedger.Views.Profile.UserNutritionProfileSummaryView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:profileVm="using:CalorieLedger.ViewModels.Profile"
    x:DataType="profileVm:UserNutritionProfileSummaryViewModel">

  <Border
      Padding="16"
      BorderThickness="1"
      CornerRadius="16">

    <StackPanel Spacing="8">

      <Grid ColumnDefinitions="*,Auto">

        <StackPanel
            Grid.Column="0"
            Spacing="3">

          <TextBlock
              Text="{Binding DisplayName}"
              FontSize="20"
              FontWeight="Bold" />

          <TextBlock
              Text="{Binding PersonalDataSummary}"
              TextWrapping="Wrap"
              Opacity="0.8" />
        </StackPanel>

        <Button
            Grid.Column="1"
            Content="Изменить"
            Command="{Binding EditProfileCommand}"
            VerticalAlignment="Top"
            Margin="12,0,0,0" />
      </Grid>

      <TextBlock
          Text="{Binding ActivitySummary}"
          TextWrapping="Wrap" />

      <TextBlock
          Text="{Binding WeightSummary}"
          FontWeight="SemiBold" />

      <TextBlock
          Text="{Binding WeightSourceSummary}"
          TextWrapping="Wrap"
          Opacity="0.7" />

      <Border
          IsVisible="{Binding HasMeasurementWarning}"
          Padding="10"
          Margin="0,4,0,0"
          BorderThickness="1"
          CornerRadius="8">

          <StackPanel Spacing="8">

              <TextBlock
                  Text="{Binding MeasurementWarning}"
                  TextWrapping="Wrap" />

              <Button
                  IsVisible="{Binding CanAddBodyMeasurement}"
                  Content="Добавить измерение"
                  Command="{Binding AddBodyMeasurementCommand}"
                  HorizontalAlignment="Left" />
          </StackPanel>
      </Border>

      <TextBlock
          IsVisible="{Binding HasBodyCompositionSummary}"
          Text="{Binding BodyCompositionSummary}"
          TextWrapping="Wrap"
          Opacity="0.75" />
    </StackPanel>
  </Border>
</UserControl>