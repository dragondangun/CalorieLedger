<UserControl
    x:Class="CalorieLedger.Views.Profile.BodyMeasurementListItemView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:profileVm="using:CalorieLedger.ViewModels.Profile"
    x:DataType="profileVm:BodyMeasurementListItemViewModel">

  <Border
      Padding="12"
      BorderThickness="1"
      CornerRadius="10">

    <StackPanel Spacing="8">

      <Grid ColumnDefinitions="*,Auto">

        <StackPanel
            Grid.Column="0"
            Spacing="2">

          <StackPanel
              Orientation="Horizontal"
              Spacing="8">

              <TextBlock
                  Text="{Binding DateSummary}"
                  VerticalAlignment="Center"
                  FontWeight="SemiBold" />

              <Border
                  IsVisible="{Binding IsLatest}"
                  Padding="6,2"
                  BorderThickness="1"
                  CornerRadius="6">

                  <TextBlock
                      Text="Текущее"
                      FontSize="11"
                      FontWeight="SemiBold" />
              </Border>
          </StackPanel>

          <TextBlock
              Text="{Binding WeightSummary}"
              FontSize="18"
              FontWeight="Bold" />
        </StackPanel>
      </Grid>

      <TextBlock
          IsVisible="{Binding HasAdditionalValues}"
          Text="{Binding AdditionalValuesSummary}"
          TextWrapping="Wrap" />

      <TextBlock
          IsVisible="{Binding HasChangesSummary}"
          Text="{Binding ChangesSummary}"
          TextWrapping="Wrap"
          FontStyle="Italic"
          Opacity="0.75" />

      <StackPanel
          IsVisible="{Binding ArePrimaryActionsVisible}"
          Orientation="Horizontal"
          HorizontalAlignment="Left"
          Spacing="8">

        <Button
            Content="Изменить"
            Command="{Binding EditCommand}" />

        <Button
            Content="Удалить"
            Command="{Binding DeleteCommand}" />
      </StackPanel>

      <Border
          IsVisible="{Binding IsDeleteConfirmationVisible}"
          Padding="10"
          Margin="0,4,0,0"
          BorderThickness="1"
          CornerRadius="8">

        <StackPanel Spacing="8">

          <TextBlock
              Text="Удалить это измерение?"
              FontWeight="SemiBold" />

          <TextBlock
              Text="Запись будет удалена из истории. Если это последнее измерение, текущий профиль вернётся к предыдущей записи."
              TextWrapping="Wrap"
              Opacity="0.75" />

          <StackPanel
              Orientation="Horizontal"
              HorizontalAlignment="Left"
              Spacing="8">

            <Button
                Content="Отмена"
                Command="{Binding CancelDeleteCommand}" />

            <Button
                Content="Удалить"
                Command="{Binding ConfirmDeleteCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>
</UserControl>