<UserControl
    x:Class="CalorieLedger.Views.History.DailyJournalHistoryView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:activityVm="using:CalorieLedger.ViewModels.Activities"
    xmlns:historyVm="using:CalorieLedger.ViewModels.History"
    xmlns:mealVm="using:CalorieLedger.ViewModels.Meals"
    xmlns:controls="using:CalorieLedger.Controls"
    x:DataType="historyVm:DailyJournalHistoryViewModel">

    <ScrollViewer>
        <StackPanel
            Margin="24"
            Spacing="14"
            MaxWidth="760"
            HorizontalAlignment="Center">

            <Grid ColumnDefinitions="*,Auto">
                <TextBlock
                    Grid.Column="0"
                    Text="История дня"
                    FontSize="26"
                    FontWeight="Bold"
                    VerticalAlignment="Center" />

                <Button
                    Grid.Column="1"
                    Content="Закрыть"
                    Command="{Binding CloseCommand}" />
            </Grid>

            <Grid
                ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="10">

                <Button
                    Grid.Column="0"
                    Content="← Предыдущий"
                    Command="{Binding PreviousDayCommand}" />

                <TextBlock
                    Grid.Column="1"
                    Text="{Binding DateSummary}"
                    FontSize="18"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />

                <Button
                    Grid.Column="2"
                    Content="Следующий →"
                    Command="{Binding NextDayCommand}" />
            </Grid>
            <Grid
                ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="10">

                <Button
                    Grid.Column="0"
                    Content="← Неделя"
                    Command="{Binding PreviousWeekCommand}" />

                <TextBlock
                    Grid.Column="1"
                    Text="{Binding WeekSummary}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold" />

                <Button
                    Grid.Column="2"
                    Content="Неделя →"
                    Command="{Binding NextWeekCommand}" />
            </Grid>

            <ScrollViewer
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Disabled">

                <ItemsControl ItemsSource="{Binding WeekDays}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate
                            x:DataType="historyVm:DailyJournalWeekDayViewModel">

                            <Button
                                Command="{Binding SelectCommand}"
                                IsEnabled="{Binding IsAvailable}"
                                Padding="8">

                                <StackPanel
                                    Width="82"
                                    Spacing="3">

                                    <TextBlock
                                        Text="{Binding DayOfWeekSummary}"
                                        HorizontalAlignment="Center"
                                        Opacity="0.75" />

                                    <TextBlock
                                        Text="{Binding DayOfMonthSummary}"
                                        HorizontalAlignment="Center"
                                        FontSize="20"
                                        FontWeight="SemiBold" />

                                    <TextBlock
                                        Text="{Binding CaloriesSummary}"
                                        HorizontalAlignment="Center"
                                        FontSize="12" />

                                    <TextBlock
                                        Text="{Binding ActivitySummary}"
                                        HorizontalAlignment="Center"
                                        FontSize="11"
                                        Opacity="0.75" />

                                    <TextBlock
                                        Text="{Binding StatusSummary}"
                                        HorizontalAlignment="Center"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap"
                                        FontSize="11"
                                        Opacity="0.75" />

                                    <TextBlock
                                        IsVisible="{Binding HasContextSummary}"
                                        Text="{Binding ContextSummary}"
                                        HorizontalAlignment="Center"
                                        FontSize="11"
                                        FontStyle="Italic" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border
                Padding="12"
                BorderThickness="1"
                CornerRadius="10">

                <StackPanel Spacing="5">
                    <TextBlock
                        Text="Сводка недели"
                        FontSize="17"
                        FontWeight="SemiBold" />

                    <TextBlock
                        Text="{Binding WeeklySummary.FoodSummary}"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="{Binding WeeklySummary.ActivitySummary}"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="{Binding WeeklySummary.AdjustedCaloriesSummary}"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="{Binding WeeklySummary.WeightSummary}"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="{Binding WeeklySummary.DataQualitySummary}"
                        TextWrapping="Wrap"
                        Opacity="0.7" />
                </StackPanel>
            </Border>
            <StackPanel Spacing="8">
                <TextBlock
                    Text="Последние 8 недель"
                    FontSize="18"
                    FontWeight="SemiBold" />

                <TextBlock
                    Text="{Binding WeekComparisonSummary}"
                    TextWrapping="Wrap"
                    Opacity="0.75" />

                <Border
    Padding="10"
    BorderThickness="1"
    CornerRadius="8">

                    <StackPanel Spacing="8">
                        <controls:WeeklyTrendChart
                            Points="{Binding TrendChartPoints}"
                            Height="280"
                            FoodBrush="DodgerBlue"
                            AdjustedBrush="MediumSeaGreen"
                            WeightBrush="Goldenrod"
                            GridBrush="Gray" />

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="16"
                            HorizontalAlignment="Center">

                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Border
                                    Width="12"
                                    Height="4"
                                    Background="DodgerBlue"
                                    VerticalAlignment="Center" />

                                <TextBlock Text="Потребление" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Border
                                    Width="12"
                                    Height="4"
                                    Background="MediumSeaGreen"
                                    VerticalAlignment="Center" />

                                <TextBlock Text="После активности" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Border
                                    Width="12"
                                    Height="4"
                                    Background="Goldenrod"
                                    VerticalAlignment="Center" />

                                <TextBlock Text="Вес" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock
                            Text="* неполная неделя"
                            FontSize="11"
                            Opacity="0.7" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding RecentWeeks}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="historyVm:JournalTrendWeekViewModel">
                            <Border
                                Padding="10"
                                BorderThickness="1"
                                CornerRadius="8">

                                <Grid ColumnDefinitions="135,*,Auto" ColumnSpacing="12">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock
                                            Text="{Binding DateRangeSummary}"
                                            FontWeight="SemiBold" />

                                        <TextBlock
                                            Text="{Binding SelectionSummary}"
                                            FontSize="11"
                                            FontStyle="Italic"
                                            Opacity="0.7" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding FoodSummary}" />

                                        <TextBlock
                                            Text="{Binding AdjustedCaloriesSummary}"
                                            Opacity="0.8" />

                                        <TextBlock
                                            Text="{Binding ActivitySummary}"
                                            Opacity="0.8" />
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="2"
                                        Spacing="2"
                                        HorizontalAlignment="Right">

                                        <TextBlock
                                            Text="{Binding WeightSummary}"
                                            TextAlignment="Right" />

                                        <TextBlock
                                            Text="{Binding DataQualitySummary}"
                                            TextAlignment="Right"
                                            FontSize="11"
                                            Opacity="0.7" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Button
                Content="Вернуться к сегодня"
                Command="{Binding GoToTodayCommand}"
                HorizontalAlignment="Center" />

            <Border
                Padding="14"
                BorderThickness="1"
                CornerRadius="10">

                <StackPanel Spacing="6">
                    <TextBlock
                        Text="{Binding CaloriesSummary}"
                        FontSize="22"
                        FontWeight="Bold" />

                    <TextBlock
                        Text="{Binding MacrosSummary}" />

                    <TextBlock
                        Text="{Binding CompletionSummary}"
                        FontStyle="Italic"
                        Opacity="0.75" />
                    <TextBlock
                        Text="{Binding DataQualitySummary}"
                        TextWrapping="Wrap"
                        Opacity="0.75" />
                </StackPanel>
            </Border>

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="10">

                <Button
                    Grid.Column="0"
                    Content="Добавить еду"
                    Command="{Binding AddFoodCommand}"
                    HorizontalAlignment="Stretch" />

                <Button
                    Grid.Column="1"
                    Content="Быстрая оценка"
                    Command="{Binding AddApproximateFoodCommand}"
                    HorizontalAlignment="Stretch" />
            </Grid>

            <Button
                Content="{Binding CompletionActionText}"
                Command="{Binding ToggleCompletionCommand}"
                HorizontalAlignment="Stretch" />

            <TextBlock
                IsVisible="{Binding HasNoMeals}"
                Text="В этот день записей питания нет."
                TextWrapping="Wrap"
                Opacity="0.75" />

            <ItemsControl
                IsVisible="{Binding HasMeals}"
                ItemsSource="{Binding MealGroups}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="10" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate
                        x:DataType="mealVm:FoodDiaryMealGroupViewModel">

                        <Border
                            Padding="10"
                            BorderThickness="1"
                            CornerRadius="10">

                            <StackPanel Spacing="8">
                                <StackPanel Spacing="4">
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="8">

                                        <TextBlock
                                            Text="{Binding Name}"
                                            FontWeight="SemiBold" />

                                        <TextBlock
                                            Text="{Binding TimeSummary}"
                                            Opacity="0.7" />

                                        <TextBlock
                                            Text="·"
                                            Opacity="0.7" />

                                        <TextBlock
                                            Text="{Binding CaloriesSummary}"
                                            Opacity="0.85" />
                                    </StackPanel>

                                    <TextBlock
                                        Text="{Binding MacrosSummary}"
                                        Opacity="0.85" />
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding FoodItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate
                                            x:DataType="mealVm:FoodDiaryFoodItemViewModel">

                                            <Border
                                                Padding="8"
                                                Margin="0,0,0,6"
                                                BorderThickness="1"
                                                CornerRadius="8">

                                                <StackPanel Spacing="4">
                                                    <TextBlock
                                                        Text="{Binding Name}"
                                                        FontWeight="SemiBold" />

                                                    <TextBlock
                                                        Text="{Binding QuantitySummary}" />

                                                    <TextBlock
                                                        Text="{Binding CaloriesSummary}" />

                                                    <TextBlock
                                                        Text="{Binding MacrosSummary}" />

                                                    <TextBlock
                                                        Text="{Binding AccuracySummary}"
                                                        FontStyle="Italic"
                                                        Opacity="0.75" />

                                                    <StackPanel
                                                        Orientation="Horizontal"
                                                        Spacing="8"
                                                        IsVisible="{Binding ArePrimaryActionsVisible}">

                                                        <Button
                                                            Content="Изменить"
                                                            Command="{Binding EditCommand}" />

                                                        <Button
                                                            Content="Удалить"
                                                            Command="{Binding DeleteCommand}" />
                                                    </StackPanel>

                                                    <Border
                                                        Padding="10"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        IsVisible="{Binding IsDeleteConfirmationVisible}">

                                                        <StackPanel Spacing="8">
                                                            <TextBlock
                                                                Text="Удалить эту запись?"
                                                                FontWeight="SemiBold" />

                                                            <StackPanel
                                                                Orientation="Horizontal"
                                                                Spacing="8">

                                                                <Button
                                                                    Content="Отмена"
                                                                    Command="{Binding CancelDeleteCommand}" />

                                                                <Button
                                                                    Content="Удалить"
                                                                    Command="{Binding ConfirmDeleteCommand}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border
                Padding="14"
                BorderThickness="1"
                CornerRadius="10">

                <StackPanel Spacing="8">
                    <TextBlock
                        Text="Дополнительная активность"
                        FontSize="18"
                        FontWeight="SemiBold" />

                    <TextBlock Text="{Binding ActivitySummary}" />

                    <TextBlock
                        Text="{Binding ActivityAdjustedCaloriesSummary}"
                        Opacity="0.75" />

                    <Button
                        Content="Добавить активность"
                        Command="{Binding AddActivityCommand}"
                        HorizontalAlignment="Left" />

                    <TextBlock
                        IsVisible="{Binding HasNoActivities}"
                        Text="В этот день дополнительная активность не записана."
                        Opacity="0.75" />

                    <ItemsControl
                        IsVisible="{Binding HasActivities}"
                        ItemsSource="{Binding Activities}">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="activityVm:ActivityItemViewModel">
                                <Border
                                    Padding="10"
                                    Margin="0,0,0,8"
                                    BorderThickness="1"
                                    CornerRadius="8">

                                    <StackPanel Spacing="5">
                                        <TextBlock
                                            Text="{Binding Name}"
                                            FontWeight="SemiBold" />

                                        <TextBlock Text="{Binding CaloriesSummary}" />

                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="8">

                                            <TextBlock
                                                Text="{Binding TimeSummary}"
                                                Opacity="0.75" />

                                            <TextBlock
                                                Text="{Binding DurationSummary}"
                                                Opacity="0.75" />
                                        </StackPanel>

                                        <TextBlock
                                            IsVisible="{Binding HasNote}"
                                            Text="{Binding Note}"
                                            TextWrapping="Wrap"
                                            Opacity="0.75" />

                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            IsVisible="{Binding ArePrimaryActionsVisible}">

                                            <Button
                                                Content="Изменить"
                                                Command="{Binding EditCommand}" />

                                            <Button
                                                Content="Удалить"
                                                Command="{Binding DeleteCommand}" />
                                        </StackPanel>

                                        <Border
                                            Padding="10"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            IsVisible="{Binding IsDeleteConfirmationVisible}">

                                            <StackPanel Spacing="8">
                                                <TextBlock
                                                    Text="Удалить эту активность?"
                                                    FontWeight="SemiBold" />

                                                <StackPanel
                                                    Orientation="Horizontal"
                                                    Spacing="8">

                                                    <Button
                                                        Content="Отмена"
                                                        Command="{Binding CancelDeleteCommand}" />

                                                    <Button
                                                        Content="Удалить"
                                                        Command="{Binding ConfirmDeleteCommand}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
