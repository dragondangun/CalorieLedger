<UserControl
    x:Class="CalorieLedger.Views.Products.ProductCatalogEditorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:productVm="using:CalorieLedger.ViewModels.Products"
    x:DataType="productVm:ProductCatalogEditorViewModel">

    <ScrollViewer>
        <StackPanel
            Margin="24"
            Spacing="14"
            MaxWidth="640"
            HorizontalAlignment="Center">

            <TextBlock
                Text="{Binding Title}"
                FontSize="26"
                FontWeight="Bold" />

            <TextBlock
                Text="Название"
                FontWeight="SemiBold" />

            <TextBox
                Text="{Binding Name, Mode=TwoWay}"
                PlaceholderText="Например: творог 5%" />

            <TextBlock
                Text="Бренд"
                FontWeight="SemiBold" />

            <TextBox
                Text="{Binding Brand, Mode=TwoWay}"
                PlaceholderText="Необязательно" />

            <TextBlock
                Text="Штрихкод"
                FontWeight="SemiBold" />

            <TextBox
                Text="{Binding Barcode, Mode=TwoWay}"
                PlaceholderText="Необязательно" />

            <TextBlock
                Text="КБЖУ указаны"
                Margin="0,8,0,0"
                FontWeight="SemiBold" />

            <ComboBox
                ItemsSource="{Binding NutritionBasisOptions}"
                SelectedItem="{Binding SelectedNutritionBasisOption, Mode=TwoWay}">

                <ComboBox.ItemTemplate>
                    <DataTemplate x:CompileBindings="False">
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Grid
                ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto,Auto,Auto"
                ColumnSpacing="12"
                RowSpacing="8">

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="Калорийность, ккал"
                    VerticalAlignment="Center" />

                <NumericUpDown
                    Grid.Row="0"
                    Grid.Column="1"
                    Value="{Binding CaloriesKcal, Mode=TwoWay}"
                    Minimum="0"
                    Maximum="100000"
                    Increment="1"
                    FormatString="0.##" />

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Text="Белки, г"
                    VerticalAlignment="Center" />

                <NumericUpDown
                    Grid.Row="1"
                    Grid.Column="1"
                    Value="{Binding ProteinG, Mode=TwoWay}"
                    Minimum="0"
                    Maximum="10000"
                    Increment="0.1"
                    FormatString="0.##" />

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Text="Жиры, г"
                    VerticalAlignment="Center" />

                <NumericUpDown
                    Grid.Row="2"
                    Grid.Column="1"
                    Value="{Binding FatG, Mode=TwoWay}"
                    Minimum="0"
                    Maximum="10000"
                    Increment="0.1"
                    FormatString="0.##" />

                <TextBlock
                    Grid.Row="3"
                    Grid.Column="0"
                    Text="Углеводы, г"
                    VerticalAlignment="Center" />

                <NumericUpDown
                    Grid.Row="3"
                    Grid.Column="1"
                    Value="{Binding CarbsG, Mode=TwoWay}"
                    Minimum="0"
                    Maximum="10000"
                    Increment="0.1"
                    FormatString="0.##" />
            </Grid>

            <Border
                Padding="12"
                BorderThickness="1"
                CornerRadius="8"
                IsVisible="{Binding HasValidationErrors}">

                <StackPanel Spacing="6">
                    <TextBlock
                        Text="Ошибки"
                        FontWeight="Bold" />

                    <ListBox
                        ItemsSource="{Binding ValidationMessages}"
                        IsHitTestVisible="False" />
                </StackPanel>
            </Border>

            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8">

                <Button
                    Content="Отмена"
                    Command="{Binding CancelCommand}" />

                <Button
                    Content="Сохранить"
                    Command="{Binding SaveCommand}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
