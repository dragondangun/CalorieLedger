<UserControl
    x:Class="CalorieLedger.Views.Meals.FoodDiaryHistoryView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mealVm="using:CalorieLedger.ViewModels.Meals"
    x:DataType="mealVm:FoodDiaryHistoryViewModel">

    <ScrollViewer>
        <StackPanel
            Margin="24"
            Spacing="14"
            MaxWidth="760"
            HorizontalAlignment="Center">

            <Grid ColumnDefinitions="*,Auto">
                <TextBlock
                    Grid.Column="0"
                    Text="История питания"
                    FontSize="26"
                    FontWeight="Bold"
                    VerticalAlignment="Center" />

                <Button
                    Grid.Column="1"
                    Content="Закрыть"
                    Command="{Binding CloseCommand}" />
            </Grid>

            <Grid
                ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="10">

                <Button
                    Grid.Column="0"
                    Content="← Предыдущий"
                    Command="{Binding PreviousDayCommand}" />

                <TextBlock
                    Grid.Column="1"
                    Text="{Binding DateSummary}"
                    FontSize="18"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />

                <Button
                    Grid.Column="2"
                    Content="Следующий →"
                    Command="{Binding NextDayCommand}" />
            </Grid>

            <Button
                Content="Вернуться к сегодня"
                Command="{Binding GoToTodayCommand}"
                HorizontalAlignment="Center" />

            <Border
                Padding="14"
                BorderThickness="1"
                CornerRadius="10">

                <StackPanel Spacing="6">
                    <TextBlock
                        Text="{Binding CaloriesSummary}"
                        FontSize="22"
                        FontWeight="Bold" />

                    <TextBlock
                        Text="{Binding MacrosSummary}" />

                    <TextBlock
                        Text="{Binding CompletionSummary}"
                        FontStyle="Italic"
                        Opacity="0.75" />
                </StackPanel>
            </Border>

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="10">

                <Button
                    Grid.Column="0"
                    Content="Добавить еду"
                    Command="{Binding AddFoodCommand}"
                    HorizontalAlignment="Stretch" />

                <Button
                    Grid.Column="1"
                    Content="Быстрая оценка"
                    Command="{Binding AddApproximateFoodCommand}"
                    HorizontalAlignment="Stretch" />
            </Grid>

            <Button
                Content="{Binding CompletionActionText}"
                Command="{Binding ToggleCompletionCommand}"
                HorizontalAlignment="Stretch" />

            <TextBlock
                IsVisible="{Binding HasNoMeals}"
                Text="В этот день записей питания нет."
                TextWrapping="Wrap"
                Opacity="0.75" />

            <ItemsControl
                IsVisible="{Binding HasMeals}"
                ItemsSource="{Binding MealGroups}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="10" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate
                        x:DataType="mealVm:FoodDiaryMealGroupViewModel">

                        <Border
                            Padding="10"
                            BorderThickness="1"
                            CornerRadius="10">

                            <StackPanel Spacing="8">
                                <StackPanel Spacing="4">
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="8">

                                        <TextBlock
                                            Text="{Binding Name}"
                                            FontWeight="SemiBold" />

                                        <TextBlock
                                            Text="{Binding TimeSummary}"
                                            Opacity="0.7" />

                                        <TextBlock
                                            Text="·"
                                            Opacity="0.7" />

                                        <TextBlock
                                            Text="{Binding CaloriesSummary}"
                                            Opacity="0.85" />
                                    </StackPanel>

                                    <TextBlock
                                        Text="{Binding MacrosSummary}"
                                        Opacity="0.85" />
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding FoodItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate
                                            x:DataType="mealVm:FoodDiaryFoodItemViewModel">

                                            <Border
                                                Padding="8"
                                                Margin="0,0,0,6"
                                                BorderThickness="1"
                                                CornerRadius="8">

                                                <StackPanel Spacing="4">
                                                    <TextBlock
                                                        Text="{Binding Name}"
                                                        FontWeight="SemiBold" />

                                                    <TextBlock
                                                        Text="{Binding QuantitySummary}" />

                                                    <TextBlock
                                                        Text="{Binding CaloriesSummary}" />

                                                    <TextBlock
                                                        Text="{Binding MacrosSummary}" />

                                                    <TextBlock
                                                        Text="{Binding AccuracySummary}"
                                                        FontStyle="Italic"
                                                        Opacity="0.75" />

                                                    <StackPanel
                                                        Orientation="Horizontal"
                                                        Spacing="8"
                                                        IsVisible="{Binding ArePrimaryActionsVisible}">

                                                        <Button
                                                            Content="Изменить"
                                                            Command="{Binding EditCommand}" />

                                                        <Button
                                                            Content="Удалить"
                                                            Command="{Binding DeleteCommand}" />
                                                    </StackPanel>

                                                    <Border
                                                        Padding="10"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        IsVisible="{Binding IsDeleteConfirmationVisible}">

                                                        <StackPanel Spacing="8">
                                                            <TextBlock
                                                                Text="Удалить эту запись?"
                                                                FontWeight="SemiBold" />

                                                            <StackPanel
                                                                Orientation="Horizontal"
                                                                Spacing="8">

                                                                <Button
                                                                    Content="Отмена"
                                                                    Command="{Binding CancelDeleteCommand}" />

                                                                <Button
                                                                    Content="Удалить"
                                                                    Command="{Binding ConfirmDeleteCommand}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
